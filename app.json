{
  "expo": {
    "name": "Senai Vyuham",
    "slug": "senai-vyuham",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/vyuha-chess-ai-logo.png",
    "userInterfaceStyle": "dark",
    "scheme": "senai-vyuham",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.senaivyuham.app",
      "infoPlist": {
        "NSCameraUsageDescription": "The immersive chess view shows a board over your camera feed."
      }
    },
    "android": {
      "package": "com.senaivyuham.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#101512",
        "foregroundImage": "./assets/vyuha-chess-ai-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/vyuha-chess-ai-logo.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/vyuha-chess-ai-logo.png",
          "imageWidth": 180,
          "backgroundColor": "#101512",
          "dark": { "backgroundColor": "#101512" }
        }
      ],
      "expo-sqlite",
      "expo-audio",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Senai Vyuham to show the chessboard over your camera view."
        }
      ],
      "expo-asset"
    ]
  }
}
