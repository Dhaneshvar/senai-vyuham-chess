# Hosting platforms supply PORT automatically.
PORT=3001

# Comma-separated production website origins. Do not use * in production.
CORS_ORIGINS=https://app.example.com

# Required behind Render, Railway, or any reverse proxy so rate limiting sees the real client IP.
TRUST_PROXY=true

# Optional PostgreSQL connection string for durable game storage.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/vyuha_chess
